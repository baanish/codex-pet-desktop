{
  "name": "codex-pet-desktop",
  "version": "1.0.0",
  "description": "Animated codex pet desktop overlay",
  "scripts": {
    "build:renderer": "esbuild src/renderer/main.ts --bundle --format=iife --outfile=dist/renderer/bundle.js --sourcemap --target=es2022",
    "build:html": "node -e \"const fs=require('fs');let h=fs.readFileSync('src/renderer/index.html','utf8');h=h.replace('__CACHEBUST__',Date.now());fs.writeFileSync('dist/renderer/index.html',h);\"",
    "build": "npm run build:renderer && npm run build:html",
    "dev": "tauri dev",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
