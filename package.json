{
  "name": "codex-pet-desktop",
  "version": "1.0.0",
  "description": "Animated codex pet desktop overlay",
  "main": "dist/main/index.js",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "build:renderer": "esbuild src/renderer/main.ts --bundle --format=iife --outfile=dist/renderer/bundle.js --sourcemap --target=es2022",
    "build:html": "cp src/renderer/index.html dist/renderer/index.html",
    "build": "npm run build:ts && npm run build:renderer && npm run build:html",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
