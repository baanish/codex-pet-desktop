{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Pet Desktop",
  "version": "1.0.0",
  "identifier": "com.aanishbhirud.codex-pet-desktop",
  "build": {
    "frontendDist": "../dist/renderer",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
